# Quaymaster configuration. Copy to `.env` (never commit it). Placeholders only.
# Every variable is validated at start-up; unknown QM_* names are rejected (typo protection).

# --- Network -------------------------------------------------------------------------------
# Bind address. Keep 127.0.0.1 unless a reverse proxy on another host needs to reach it.
QM_HOST=127.0.0.1
QM_PORT=8787
# Exact browser origin(s) of the UI, comma separated (CSRF Origin check). Default: derived from host/port.
QM_PUBLIC_ORIGIN=
# IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted. Never "true" or 0.0.0.0/0.
QM_TRUST_PROXY=
# Set true when served over HTTPS: Secure + __Host- cookie prefix + HSTS.
QM_COOKIE_SECURE=false

# --- Storage and secrets -------------------------------------------------------------------
QM_DATA_DIR=./data
# REQUIRED. >= 32 random bytes, hex or base64:  openssl rand -base64 32   (or use QM_SECRET_KEY_FILE)
QM_SECRET_KEY=
QM_SECRET_KEY_FILE=

# --- First-run admin (optional) --------------------------------------------------------------
# Without these, a one-time setup token is printed to stderr and written to <data>/setup-token.
# Applied ONLY while the users table is empty. Hash format: scrypt$N$r$p$saltBase64$hashBase64
QM_ADMIN_USER=
QM_ADMIN_PASSWORD_HASH=
# Alternative: a file containing the plain password (hashed at first start).
QM_ADMIN_PASSWORD_FILE=

# --- Docker ----------------------------------------------------------------------------------
QM_DOCKER_SOCKET=/var/run/docker.sock
QM_DOCKER_BIN=docker
# REQUIRED. Comma-separated absolute directories that may hold Compose projects. Compose files are
# trusted only if their realpath lies under one of these (and never under the Docker data root).
# In container mode mount them read-only at the SAME absolute path.
QM_STACK_PATHS=/opt/stacks
# Container mode: Docker data root mounted read-only, used only for free-space (statfs) checks.
QM_DOCKER_ROOT_MOUNT=

# --- Safety ----------------------------------------------------------------------------------
# Disable every mutating action (enforced in the Docker transport and the Compose runner).
QM_READ_ONLY=false
# Glob allow-list of container/project names that may be mutated. Empty = everything.
QM_MANAGED_SCOPE=
# Containers that must never be mutated (e.g. the socket proxy and reverse proxy in front of Quaymaster).
QM_PROTECTED=
# Container ID/name of Quaymaster itself; auto-detected from /proc/self/mountinfo when empty.
QM_SELF_CONTAINER=
# Mask every environment value in API output.
QM_REDACT_ALL_ENV=false

# --- Sessions and streams ----------------------------------------------------------------------
QM_SESSION_IDLE_MINUTES=30
QM_SESSION_ABSOLUTE_HOURS=12
QM_SSE_MAX_PER_SESSION=8
QM_SSE_MAX_TOTAL=32
# Back-pressure cap for log follow streams (bytes per second).
QM_LOG_FOLLOW_BYTES_PER_SEC=524288
# scrypt cost as log2(N). 17 = N=2^17. Values below 14 are only accepted with NODE_ENV=test.
QM_SCRYPT_LOG2_N=17

# --- Monitoring and retention ------------------------------------------------------------------
QM_STATS_INTERVAL_SECONDS=10
QM_STATS_RETENTION_HOURS=48
QM_EVENT_RETENTION_DAYS=14
# Minimum 30 (the audit table refuses to delete younger rows).
QM_AUDIT_RETENTION_DAYS=365
# Free space that must remain on the Docker root before pulls (used from phase 2).
QM_DISK_FLOOR_BYTES=5368709120
# `system df` is expensive; refreshed at most this often unless an admin forces it.
QM_DF_MIN_INTERVAL_SECONDS=21600

# --- Process -----------------------------------------------------------------------------------
QM_LOG_LEVEL=info
# Skip event watcher / stats sampler / housekeeping (diagnostics only).
QM_DISABLE_BACKGROUND=false

# --- Visibility (demo / screenshots) ------------------------------------------------------------
# Glob: resources whose name does not match are hidden from every API response (read-side filter,
# independent of QM_MANAGED_SCOPE). Empty = everything visible.
QM_VISIBLE_SCOPE=

# --- Updates and cleanup -----------------------------------------------------------------------
# Static web bundle directory (the image sets this up; only change for custom layouts).
# QM_WEB_DIR=
# Plain-HTTP registries allowed (comma-separated hosts). Leave empty unless you run a local registry.
QM_REGISTRY_INSECURE=
QM_CHECK_TTL_MINUTES=360
QM_ROLLBACK_RETENTION_DAYS=7
QM_CLEANUP_MIN_AGE_HOURS=24
QM_APPROVAL_EXPIRY_HOURS=48

# --- Compose deployment only (read by deploy/docker-compose.yml, ignored by Quaymaster itself) ---------
# Not QM_* variables (Quaymaster rejects unknown QM_*). DOCKER_GID is mandatory for the compose file.
# Host group id of the Docker socket:  stat -c %g /var/run/docker.sock
DOCKER_GID=
DEPLOY_BIND=127.0.0.1
DEPLOY_PORT=8787
DEPLOY_STACKS_DIR=/opt/stacks
DEPLOY_IMAGE=ghcr.io/hadieht/quaymaster:latest   # pin a version, e.g. ghcr.io/hadieht/quaymaster:0.1.0; use quaymaster:dev for a local build
