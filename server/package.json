{
  "name": "@quaymaster/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "QM_DEV=1 tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@quaymaster/shared": "*",
    "better-sqlite3": "^11.0.0",
    "croner": "^11.0.0",
    "dockerode": "^4.0.0",
    "fastify": "^5.0.0",
    "js-yaml": "^4.3.2",
    "nodemailer": "^10.5.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/dockerode": "^3.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
